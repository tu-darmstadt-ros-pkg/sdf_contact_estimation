<?xml version="1.0"?>
<!-- Minimal tracked robot for the unit tests: two main tracks (boxes whose
     bottom face is at z = 0 in base_link) and a chassis above them. -->
<robot name="test_robot">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.1"/>
      <mass value="20.0"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <collision>
      <origin xyz="0 0.2 0.05"/>
      <geometry><box size="0.6 0.1 0.1"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.2 0.05"/>
      <geometry><box size="0.6 0.1 0.1"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry><box size="0.4 0.3 0.1"/></geometry>
    </collision>
  </link>
</robot>
